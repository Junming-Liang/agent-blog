    }
  ],
  "requires": [
    "markdown"
  ],
  "optionalRequires": [
    "editor"
  ],
  "extends": [],
  "dependencies": {
    "highlight.js": "^11.11.0"
  },
  "peerDependencies": {
    "@agent-blog/core": "^0.2.0"
  },
  "source": {
    "type": "builtin",
    "path": "packages/highlight",
    "package": "@agent-blog/highlight"
  }
