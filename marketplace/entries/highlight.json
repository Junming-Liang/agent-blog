{
  "schemaVersion": 1,
  "id": "highlight",
  "name": "代码高亮",
  "summary": "渲染代码围栏的语法高亮；可选提供编辑器代码块按钮。",
  "category": "rendering",
  "apiVersion": 1,
  "license": "MIT",
  "authors": [
    {
      "name": "Agent Blog contributors",
